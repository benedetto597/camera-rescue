<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.s23plus.camera"
    android:versionCode="6"
    android:versionName="2.0.0">

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="34" />

    <!-- Permisos Camera2 y audio opcional para grabacion MP4 en el visor universal -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Sin permiso INTERNET: aplicacion 100% offline y privada por diseno -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <queries>
        <package android:name="com.sec.android.app.camera" />
        <intent>
            <action android:name="com.sec.android.app.camera.action.SCAN_QR_CODE" />
        </intent>
        <intent>
            <action android:name="com.samsung.settings.FUNCTION_KEY_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Samsung Camera Rescue"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Samsung Camera Rescue"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RearCaptureService"
            android:exported="true"
            android:label="Samsung Camera Rescue — Obturador Trasero"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".CameraRescueTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_camera_rescue"
            android:label="Rescate Cámara"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

    </application>

</manifest>
